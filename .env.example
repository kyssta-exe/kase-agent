# Kase Agent - Environment Configuration
# Copy this to ~/.kase/.env and fill in your keys

# === LLM Providers (at least one required) ===
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."
# DEEPSEEK_API_KEY="..."
# OPENROUTER_API_KEY="..."

# === Model Configuration ===
# KASE_MODEL="gpt-4o"
# KASE_PROVIDER="openai"
# KASE_FALLBACK_MODEL="gpt-4o-mini"

# === Security ===
# KASE_REDACT_SECRETS="true"

# === Behavior ===
# KASE_QUIET="false"
# KASE_VERBOSE="false"
